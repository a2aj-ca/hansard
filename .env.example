# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
# Every variable below is optional; with none set, the pipeline uses the defaults
# shown here (local MongoDB, no proxy, polite ~1-3s delay between requests).

# --- MongoDB ---
# Full connection URI. Override for auth, TLS, a replica set, or MongoDB Atlas,
# e.g. mongodb+srv://user:pass@cluster.example.net/
MONGO_URI=mongodb://localhost:27017/
# Database to read/write within that server.
MONGO_DB_NAME=hansard

# --- Outbound HTTP proxy (optional) ---
# All three must be set for the proxy to be used; otherwise requests go out
# directly. PROXY is the host (and port), e.g. host:port.
PROXY=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Request tuning ---
# Politeness delay between requests: each waits REQUEST_DELAY_MIN seconds plus a
# random amount up to REQUEST_DELAY_JITTER (so the default is ~1-3s). Raise to be
# gentler on the source site; lower to scrape faster.
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_JITTER=2.0
# Per-request timeout (seconds) and how many times to retry on errors / 429 / 5xx.
HTTP_TIMEOUT=30
HTTP_RETRIES=4
